{
    "name": "akp/portal-sso",
    "description": "Penerima login terpusat AKPSatu (SSO) untuk aplikasi Laravel di super app AKP.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^6.10|^7.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/session": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Akp\\PortalSso\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Akp\\PortalSso\\PortalSsoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}